{
    "name": "buggregator/trap",
    "description": "A simple and powerful tool for debugging PHP applications.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "debug",
        "cli",
        "console",
        "sentry",
        "smtp",
        "dump",
        "binary dump",
        "websockets",
        "server",
        "helper",
        "dev",
        "fibers",
        "dumper"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Pavel Buchnev",
            "homepage": "https://github.com/butschster"
        }
    ],
    "homepage": "https://buggregator.dev/",
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-sockets": "*",
        "internal/container": "^1.1",
        "internal/destroy": "^1.0",
        "nyholm/psr7": "^1.8.1",
        "php-http/message": "^1.15",
        "psr/http-message": "^1.1 || ^2",
        "psr/log": "^2 || ^3",
        "symfony/console": "^6.4 || ^7 || ^8",
        "symfony/var-dumper": "^6.3 || ^7 || ^8"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "google/protobuf": "^3.25 || ^4.30 || ^v5.36.1",
        "llm/skills": "^1.14",
        "mockery/mockery": "^1.6.13",
        "open-telemetry/gen-otlp-protobuf": "^1.10",
        "roxblnfk/unpoly": "^1.8",
        "testo/bridge-infection": "^0.1.9",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.56"
    },
    "suggest": {
        "ext-excimer": "To profile code with trap()::profile() using the Excimer sampling profiler",
        "ext-simplexml": "To load trap.xml",
        "ext-tideways_xhprof": "To profile code with trap()::profile() using XHProf",
        "ext-xhprof": "To profile code with trap()::profile() using XHProf",
        "google/protobuf": "To receive OpenTelemetry traces encoded as OTLP/HTTP protobuf (with open-telemetry/gen-otlp-protobuf)",
        "open-telemetry/gen-otlp-protobuf": "To receive OpenTelemetry traces encoded as OTLP/HTTP protobuf",
        "roxblnfk/unpoly": "If you want to remove unnecessary PHP polyfills depend on PHP version."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Buggregator\\Trap\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Buggregator\\Trap\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/trap"
    ],
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "ergebnis/composer-normalize": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --min-msi=70 --min-covered-msi=70"
        ],
        "infect:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --threads=max --logger-github --show-mutations=0 --min-msi=70 --min-covered-msi=70"
        ],
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "refactor": "rector process --config=tools/rector/rector.php",
        "refactor:ci": "rector process --config=tools/rector/rector.php --dry-run --ansi",
        "structarmed": "structarmed analyse --config=tools/structarmed/structarmed.php",
        "structarmed:ci": "structarmed analyse --config=tools/structarmed/structarmed.php --no-progress",
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:arch": "testo --suite=Arch",
        "test:acceptance": "testo --suite=Acceptance",
        "test:bench": "@php -d memory_limit=-1 -d zend.enable_gc=0 -d xdebug.mode=off vendor/bin/testo --suite=Bench"
    }
}
